{
  "manifest_version": 3,
  "name": "Emotion Detector",
  "version": "2.0.0",
  "description": "Real-time emotion detection for social media content.",
  "author": "AlienMinus",

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://emotion-detection-browser-extention.vercel.app/*",

    "*://*.youtube.com/*",
    "*://*.facebook.com/*",
    "*://*.twitter.com/*",
    "*://*.x.com/*",
    "*://*.linkedin.com/*",
    "*://*.reddit.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "*://*.twitter.com/*",
        "*://*.x.com/*",
        "*://*.reddit.com/*",
        "*://*.facebook.com/*",
        "*://*.youtube.com/*",
        "*://*.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Emotion Detector",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },

  "icons": {
    "128": "icon.png"
  }
}